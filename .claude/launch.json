{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "fathom-api",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "--directory", "apps/api", "uvicorn", "app.main:app", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "fathom-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "apps/web", "run", "dev", "--", "--port", "3000"],
      "port": 3000
    }
  ]
}
